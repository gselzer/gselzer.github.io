---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
const allPosts = await getCollection('blog');
const allLinks = await getCollection('external');
const pageTitle = "Writings";
---

<BaseLayout pageTitle={pageTitle}>
	<h1>Blog Posts</h1>
	<ul>
		{allPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()).map((post: any) => <BlogPost post={post} />)}
	</ul>
	<h1>Other Writings</h1>
	<ul>
		{allLinks.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()).map((post: any) => <BlogPost post={post} />)}
	</ul>
</BaseLayout>